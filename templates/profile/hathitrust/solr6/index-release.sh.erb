#!/bin/bash

onoe () {
  echo "${1}"
  exit 1
}

base=/htsolr/<%= @solr_name %>
serve=/htsolr/serve
manual_snap="$1"
if [[ -n "${manual_snap}" ]]; then
  snap="${base}/.zfs/snapshot/${manual_snap}"
  if ! [[ -d "${snap}" ]]; then
    echo "can't find snapshot: '${manual_snap}'"
    echo "valid snapshots are: "
    /bin/ls ${base}/.zfs/snapshot/
    exit 1
  fi
  snapname="$(basename "${snap}")"
else
  snaps=( "${base}/.zfs/snapshot/htsolr-<%= @solr_name %>_"* )
  snap="${snaps[-1]}"
  snapname="$(basename "${snap}")"
  [[ "$snapname" = "htsolr-<%= @solr_name %>_$(date +%Y-%m-%d)"* ]] || onoe "latest snap was not made today, refusing to run automatic release"
fi

# check if the administrative release stop flag is set
[[ -f "${base}/flags/<%= @solr_stop_flag %>" ]] && onoe "<%= @solr_stop_flag %> flag present...skip release today"

# check that today's snap exists
[[ ! -d ${snap}/cores/ ]] && onoe "can't read snapshot dir...aborting release"
[[ ! -d ${snap}/flags/ ]] && onoe "can't read snapshot dir...aborting release"

# check today's snap for 'busy' flag
[[ -f "${snap}/flags/busy" ]] && onoe "indexing or optimization occurring...skip release today"

<% if @is_primary_site -%>
# TODO: check whether release happened at mirror site
# ...

<% end -%>
# check that cores appear valid
<% @solr_cores.each do |core| %>
<% if @is_lss -%>
[[ ! -d ${snap}/cores/<%= core %>/core-<%= core %>x/data/index ]] && onoe "core data missing...aborting release"
segments=( "${snap}/cores/<%= core %>/core-<%= core %>x/data/index/"*.fdt )
(( (${#segments[@]} > 0) && (${#segments[@]} <= 2) )) || onoe "core '<%= core %>' served by $(hostname -s) has an improper number of segments...aborting release"
<% else -%>
[[ ! -d ${snap}/cores/<%= core %>/data/index ]] && onoe "core data missing...aborting release"
segments=( "${snap}/cores/<%= core %>/data/index/"*.fdt )
(( ${#segments[@]} > 0 )) || onoe "core '<%= core %>' served by $(hostname -s) has an improper number of segments...aborting release"
<% end -%>
<% end -%>

# stop solr
systemctl stop solr || onoe "error stopping solr on $(hostname -s)"

# replace the snapshot symlinks
<% if @is_lss -%>
rm -f ${serve}/lss-shared && ln -s "${snap}/shared" ${serve}/lss-shared || \
  onoe "error removing or creating /htsolr/serve/lss-shared symlink...solr WILL NOT be started on $(hostname -s)"
<% end -%>
<% @solr_cores.each do |core| -%>
rm -f ${serve}/<%= @core_link_prefix %><%= core %> && ln -s "${snap}/cores/<%= core %>" ${serve}/<%= @core_link_prefix %><%= core %> || \
  onoe "error removing or creating symlink for core <%= core %>...solr WILL NOT be started on $(hostname -s)"
<% end -%>

# umount stale snaps
for x in $(findmnt --mountpoint $base -RJ | jq -r '.filesystems[] | select(.children) | .children[].target | select(. != "'"${snap}"'")'); do
  umount "$x"
done

# if all went well, start solr
systemctl start solr || onoe "error starting solr on $(hostname -s)"

<% if @is_primary_node -%>
# touch release flag (only on first core/node, so it happens once per datacenter)
rm -f "/htapps/babel/flags/web/<%= @release_flag_prefix %><%= @solr_name %>-release-"*
touch "/htapps/babel/flags/web/<%= @release_flag_prefix %><%= @solr_name %>-release-${snapname}"

<% end -%>
<% if @is_lss -%>
# run the first query to initialize lss solr
INITQUERY=0
sleep 5
<% @solr_cores.each do |core| -%>
if ! wget -q -T 60 -t 5 -O - "http://solr-sdr-search-<%= core %>:8081/solr/core-<%= core %>x/select/?q=aardvark&version=2.2&start=0&rows=10&indent=on" >& /dev/null; then
  echo "WARN: failed to perform initial query against core <%= core %>x after successful release"
  INITQUERY=1
fi
if ! wget -q -T 60 -t 5 -O - "http://solr-sdr-search-<%= core %>:8081/solr/core-<%= core %>y/select?indent=on&q=*:*&rows=0" >& /dev/null; then
  echo "WARN: failed to perform initial query against core <%= core %>y after successful release"
  INITQUERY=1
fi
<% end -%>

<% if @is_primary_node -%>
# cache warming, after delay to avoid racing with other nodes
sleep 30
wget -nv -i ${base}/prep/cacheWarm169Common.txt -O - 2>/tmp/cache-warming-lss.log 1>/dev/null
rm -f "/htapps/babel/flags/web/<%= @release_flag_prefix %>lss-warming-"*
touch "/htapps/babel/flags/web/<%= @release_flag_prefix %>lss-warming-${snapname}"

<% end -%>
exit ${INITQUERY}
<% end -%>
<% if @is_catalog -%>
# run the first query to initialize catalog solr
sleep 5
if ! wget -q -T 60 -t 5 -O - "http://solr-sdr-catalog:9033/solr/catalog/select?q=*:*" >& /dev/null; then
  onoe "WARN: failed to perform initial query after successful release"
fi
<% end -%>
